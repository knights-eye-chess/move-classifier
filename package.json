{
  "name": "@knights-eye-chess/move-classifier",
  "version": "0.1.0-dev.14",
  "private": true,
  "type": "module",
  "description": "Private reusable classification preview with native Knight’s Eye policy and optional engine acquisition",
  "files": [
    "dist",
    "src",
    "test",
    "tests",
    "build.mjs",
    "README.md",
    "SOURCE-ORIGIN.json",
    "scripts",
    "LICENSE",
    "NOTICE",
    "LICENSING.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "NPM-PUBLISHING.md",
    "npm-release.json",
    "docs"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./contracts": {
      "types": "./dist/recorded-decision.d.ts",
      "import": "./dist/recorded-decision.js"
    },
    "./policy/knights-eye": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./compatibility": {
      "types": "./dist/compatibility.d.ts",
      "import": "./dist/compatibility.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs dist/*.test.mjs",
    "check": "npm run build && npm test",
    "pack:checked": "npm run check && node scripts/pack.mjs",
    "pack:artifact": "node scripts/pack.mjs",
    "publish:verify": "node scripts/verify-release.mjs",
    "publish:prepare": "npm run pack:checked && npm run publish:verify"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "chess.js": "1.4.0",
    "esbuild": "0.28.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knights-eye-chess/move-classifier.git"
  },
  "license": "MIT"
}
